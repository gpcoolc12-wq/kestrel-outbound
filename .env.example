# OpenRouter key for the research/drafting model (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id. Default: anthropic/claude-sonnet-5.5
OPENROUTER_MODEL=
# Linear personal API key (Linear > Settings > Security & access > Personal API keys).
# Leave empty and pass --local to use the file-based Linear stand-in.
LINEAR_API_KEY=
# Name shown in the From: line of outbox emails
SENDER=Gaurav Pawar
